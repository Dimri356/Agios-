# Clé secrète Stripe (mode test au début) — Stripe Dashboard > Développeurs > Clés API
STRIPE_SECRET_KEY=sk_test_...

# Clé de signature du webhook — créée à l'étape "brancher le webhook"
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique du site (sans / à la fin), ex: https://agios.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
